# Copier ce fichier en .env puis remplir. Le fichier .env n'est jamais commité.

# Clé API Claude (https://console.anthropic.com) : obligatoire.
ANTHROPIC_API_KEY=

PORT=8787

# Modèle et niveau de réflexion (low, medium, high). « low » = réponses rapides pour le chat.
SAHLA_MODELE=claude-opus-5-5
SAHLA_EFFORT=low

# API Sehelli. Vide = données de démonstration (lieux, prix et commandes fictifs).
SEHELLI_API_URL=
# Clé envoyée à l'API Sehelli dans l'en-tête X-Sahla-Cle (optionnel).
SEHELLI_API_CLE=

# Origines web autorisées (CORS), séparées par des virgules. L'app mobile n'en a pas besoin.
SAHLA_ORIGINES=*
# 1 = refuser les utilisateurs non connectés (recommandé en production).
SAHLA_CONNEXION_OBLIGATOIRE=0
# 0 = ne pas servir la page de démo sur /.
SAHLA_PAGE_DEMO=1

# Limites par utilisateur (maîtrise des coûts).
SAHLA_LIMITE_MINUTE=10
SAHLA_LIMITE_JOUR=200
SAHLA_MAX_CARACTERES=2000
SAHLA_MAX_TOURS=40
